{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node tools/sitzungsstart.mjs",
            "timeout": 20,
            "statusMessage": "Projektstand wird gelesen"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node tools/pruefe-schleuse.mjs",
            "if": "Bash(git *)",
            "timeout": 300,
            "statusMessage": "Schleuse prueft"
          }
        ]
      }
    ]
  }
}
